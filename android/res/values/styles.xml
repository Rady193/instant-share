<?xml version="1.0" encoding="utf-8"?>
<!-- Multi Screens' dark appearance until the page says otherwise (MainActivity.applyTheme) -->
<resources>
    <color name="bg">#121314</color>
    <color name="surface">#191A1B</color>
    <color name="icon_bg">#5B2C83</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorPrimaryDark">@color/surface</item>
        <item name="android:colorAccent">#5B2C83</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>
